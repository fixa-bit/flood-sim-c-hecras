# Optional overrides. Downloaded FABDEM is served automatically as local viewer
# terrain; without local data or an override the globe uses an ellipsoid.
VITE_CESIUM_ION_TOKEN=
# A self-hosted quantized-mesh terrain URL built from the scenario's FABDEM clip.
VITE_LOCAL_TERRAIN_URL=
# Backend environment variables (PowerShell: $env:FLOOD_WORKSPACE = 'D:\\flood-data')
# FLOOD_WORKSPACE defaults to ./workspace (ignored by Git).
# HEC_RAS_EXE points to your installed Ras.exe. Install ras-commander[compute] separately.
